{
    "name": "printosa",
    "version": "1.0.0",
    "description": "Motor de Impressão Local da Brasume",
    "author": "Kauê Friedrich <kauef89@gmail.com>",
    "company": "Brasume",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "start": "electron .",
        "build:win": "electron-builder --win --x64",
        "build:mac": "electron-builder --mac",
        "build:linux": "electron-builder --linux"
    },
    "build": {
        "appId": "com.brasume.print",
        "productName": "BrasumePrint",
        "protocols": [
            {
                "name": "BrasumePrint",
                "schemes": [
                    "brasumeprint"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "mac": {
            "target": [
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ]
        }
    },
    "dependencies": {
        "axios": "^1.6.0",
        "electron-store": "^8.1.0",
        "escpos": "^3.0.0-alpha.6",
        "escpos-network": "^3.0.0-alpha.6",
        "escpos-usb": "^3.0.0-alpha.4",
        "laravel-echo": "^1.15.3",
        "pusher-js": "^8.3.0",
        "@thiagoelg/node-printer": "latest",
        "node-thermal-printer": "latest"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    }
}
